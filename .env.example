# Copy to .env (git-ignored) and fill in. CI gets the same variables from its secret store:
# Jenkins credential `test-card-number` (Secret text), GitHub Actions secret `TEST_CARD_NUMBER`.

# Test card number for the payment form (the site processes no real payment). Never commit a value.
TEST_CARD_NUMBER=

# Local Jenkins (localhost:9090): the Jenkins user ID (not the display name) and an API token
# from /user/<id>/security. Used by Claude to trigger builds and to register the `jenkins` MCP server.
JENKINS_USER=
JENKINS_API_TOKEN=
