  {
   "id": 1,
   "type": "stat",
   "title": "Pass rate (latest run)",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "test-history"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "test-history"
     },
     "queryType": "table",
     "rawQueryText": "SELECT ROUND(100.0*passed/(passed+failed+flaky+skipped),1) AS \"Pass rate\" FROM runs ORDER BY build DESC LIMIT 1",
     "queryText": "SELECT ROUND(100.0*passed/(passed+failed+flaky+skipped),1) AS \"Pass rate\" FROM runs ORDER BY build DESC LIMIT 1",
     "timeColumns": [
      "time"
     ]
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "green",
        "value": 98
       }
      ]
     },
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
