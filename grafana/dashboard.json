       "id": "byName",
       "options": "Status"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "Passed": {
            "color": "green",
            "index": 0
           },
           "Failed": {
            "color": "red",
            "index": 1
           },
