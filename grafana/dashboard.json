  {
   "id": 11,
   "type": "table",
   "title": "All tests in latest run (click a test name for details)",
   "datasource": {
    "type": "frser-sqlite-datasource",
    "uid": "test-history"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 24,
    "h": 12
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "frser-sqlite-datasource",
      "uid": "test-history"
     },
     "queryType": "table",
     "rawQueryText": "SELECT title AS Test, CASE status WHEN 'expected' THEN 'Passed' WHEN 'unexpected' THEN 'Failed' WHEN 'flaky' THEN 'Flaky' ELSE 'Skipped' END AS Status, ROUND(duration_ms/1000.0,1) AS \"Duration (s)\", attempts AS Attempts, project AS Project, file || ':' || line AS Location, started AS Started, url FROM tests WHERE build=(SELECT MAX(build) FROM runs) ORDER BY CASE status WHEN 'unexpected' THEN 0 WHEN 'flaky' THEN 1 ELSE 2 END, title",
     "queryText": "SELECT title AS Test, CASE status WHEN 'expected' THEN 'Passed' WHEN 'unexpected' THEN 'Failed' WHEN 'flaky' THEN 'Flaky' ELSE 'Skipped' END AS Status, ROUND(duration_ms/1000.0,1) AS \"Duration (s)\", attempts AS Attempts, project AS Project, file || ':' || line AS Location, started AS Started, url FROM tests WHERE build=(SELECT MAX(build) FROM runs) ORDER BY CASE status WHEN 'unexpected' THEN 0 WHEN 'flaky' THEN 1 ELSE 2 END, title",
