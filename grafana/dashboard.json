     "queryText": "SELECT CASE status WHEN 'expected' THEN 'Passed' WHEN 'unexpected' THEN 'Failed' WHEN 'flaky' THEN 'Flaky' ELSE 'Skipped' END AS Status, COUNT(*) AS Tests FROM tests WHERE build=(SELECT MAX(build) FROM runs) GROUP BY status",
