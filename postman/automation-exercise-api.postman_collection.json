{
  "info": {
    "name": "Automation Exercise API",
    "description": "Mirrors the 16 API test cases in docs/test-cases/api.md and tests/api/. Run the whole collection top-to-bottom with the Collection Runner (or `newman run`) — 'Account Lifecycle - Setup' creates a test account that later folders reuse via {{testEmail}}/{{testPassword}}, and 'Account Lifecycle - Teardown' deletes it at the end. Every response's real outcome is in the JSON body's `responseCode` field; the HTTP transport status is always 200.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://automationexercise.com" },
    { "key": "testEmail", "value": "" },
    { "key": "testPassword", "value": "TestPass123!" }
  ],
  "item": [
    {
      "name": "Account Lifecycle - Setup",
      "item": [
        {
          "name": "Create Account",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', `postman_test_${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('HTTP status is 200 (transport layer)', () => pm.response.to.have.status(200));",
                  "pm.test('responseCode is 201', () => pm.expect(body.responseCode).to.eql(201));",
                  "pm.test('message is User created!', () => pm.expect(body.message).to.eql('User created!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "QA Postman User" },
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "{{testPassword}}" },
                { "key": "title", "value": "Mr" },
                { "key": "birth_date", "value": "10" },
                { "key": "birth_month", "value": "5" },
                { "key": "birth_year", "value": "1996" },
                { "key": "firstname", "value": "QA" },
                { "key": "lastname", "value": "Postman" },
                { "key": "company", "value": "Test Company" },
                { "key": "address1", "value": "123 Test Street" },
                { "key": "address2", "value": "" },
                { "key": "country", "value": "United States" },
                { "key": "zipcode", "value": "90001" },
                { "key": "state", "value": "CA" },
                { "key": "city", "value": "Los Angeles" },
                { "key": "mobile_number", "value": "1234567890" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/createAccount",
              "host": ["{{baseUrl}}"],
              "path": ["api", "createAccount"]
            }
          }
        },
        {
          "name": "Get User Detail By Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('returned user matches created account', () => {",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "  pm.expect(body.user.first_name).to.eql('QA');",
                  "  pm.expect(body.user.last_name).to.eql('Postman');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/getUserDetailByEmail?email={{testEmail}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "getUserDetailByEmail"],
              "query": [{ "key": "email", "value": "{{testEmail}}" }]
            }
          }
        },
        {
          "name": "Update Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('message is User updated!', () => pm.expect(body.message).to.eql('User updated!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "name", "value": "QA Postman Updated" },
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "{{testPassword}}" },
                { "key": "title", "value": "Mr" },
                { "key": "birth_date", "value": "11" },
                { "key": "birth_month", "value": "6" },
                { "key": "birth_year", "value": "1996" },
                { "key": "firstname", "value": "QAUpdated" },
                { "key": "lastname", "value": "PostmanUpdated" },
                { "key": "company", "value": "Test Company" },
                { "key": "address1", "value": "456 Updated Street" },
                { "key": "address2", "value": "" },
                { "key": "country", "value": "United States" },
                { "key": "zipcode", "value": "94105" },
                { "key": "state", "value": "CA" },
                { "key": "city", "value": "San Francisco" },
                { "key": "mobile_number", "value": "9876543210" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/updateAccount",
              "host": ["{{baseUrl}}"],
              "path": ["api", "updateAccount"]
            }
          }
        }
      ]
    },
    {
      "name": "Login Verification",
      "item": [
        {
          "name": "Verify Login - Valid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('message is User exists!', () => pm.expect(body.message).to.eql('User exists!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "{{testPassword}}" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verifyLogin"]
            }
          }
        },
        {
          "name": "Verify Login - Non-matching Credentials",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.variables.set('bogusEmail', `nonexistent_${Date.now()}@example.com`);"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 404', () => pm.expect(body.responseCode).to.eql(404));",
                  "pm.test('message is User not found!', () => pm.expect(body.message).to.eql('User not found!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{bogusEmail}}" },
                { "key": "password", "value": "whatever123" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verifyLogin"]
            }
          }
        },
        {
          "name": "Verify Login - Missing Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 400', () => pm.expect(body.responseCode).to.eql(400));",
                  "pm.test('message mentions email or password', () => pm.expect(body.message).to.include('email or password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [{ "key": "email", "value": "{{testEmail}}" }]
            },
            "url": {
              "raw": "{{baseUrl}}/api/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verifyLogin"]
            }
          }
        },
        {
          "name": "Verify Login - Unsupported Method (DELETE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 405', () => pm.expect(body.responseCode).to.eql(405));",
                  "pm.test('message is This request method is not supported.', () => pm.expect(body.message).to.eql('This request method is not supported.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verifyLogin"]
            }
          }
        }
      ]
    },
    {
      "name": "Products & Brands",
      "item": [
        {
          "name": "Get Products List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('products is a non-empty array', () => {",
                  "  pm.expect(Array.isArray(body.products)).to.be.true;",
                  "  pm.expect(body.products.length).to.be.above(0);",
                  "});",
                  "pm.test('first product has expected fields', () => {",
                  "  const p = body.products[0];",
                  "  pm.expect(p).to.have.all.keys('id', 'name', 'price', 'brand', 'category');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/productsList", "host": ["{{baseUrl}}"], "path": ["api", "productsList"] }
          }
        },
        {
          "name": "Products List - Unsupported Method (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 405', () => pm.expect(body.responseCode).to.eql(405));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/productsList", "host": ["{{baseUrl}}"], "path": ["api", "productsList"] }
          }
        },
        {
          "name": "Get Brands List",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('brands is a non-empty array', () => {",
                  "  pm.expect(Array.isArray(body.brands)).to.be.true;",
                  "  pm.expect(body.brands.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/brandsList", "host": ["{{baseUrl}}"], "path": ["api", "brandsList"] }
          }
        },
        {
          "name": "Brands List - Unsupported Method (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 405', () => pm.expect(body.responseCode).to.eql(405));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/brandsList", "host": ["{{baseUrl}}"], "path": ["api", "brandsList"] }
          }
        }
      ]
    },
    {
      "name": "Product Search",
      "item": [
        {
          "name": "Search Product - Valid Parameter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('products array is non-empty', () => pm.expect(body.products.length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [{ "key": "search_product", "value": "top" }] },
            "url": { "raw": "{{baseUrl}}/api/searchProduct", "host": ["{{baseUrl}}"], "path": ["api", "searchProduct"] }
          }
        },
        {
          "name": "Search Product - Missing Parameter",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 400', () => pm.expect(body.responseCode).to.eql(400));",
                  "pm.test('message mentions search_product', () => pm.expect(body.message).to.include('search_product'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [] },
            "url": { "raw": "{{baseUrl}}/api/searchProduct", "host": ["{{baseUrl}}"], "path": ["api", "searchProduct"] }
          }
        }
      ]
    },
    {
      "name": "Account Lifecycle - Teardown",
      "item": [
        {
          "name": "Delete Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 200', () => pm.expect(body.responseCode).to.eql(200));",
                  "pm.test('message is Account deleted!', () => pm.expect(body.message).to.eql('Account deleted!'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "{{testPassword}}" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/deleteAccount", "host": ["{{baseUrl}}"], "path": ["api", "deleteAccount"] }
          }
        },
        {
          "name": "Verify Login After Deletion",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('responseCode is 404 (account no longer exists)', () => pm.expect(body.responseCode).to.eql(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "email", "value": "{{testEmail}}" },
                { "key": "password", "value": "{{testPassword}}" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/verifyLogin", "host": ["{{baseUrl}}"], "path": ["api", "verifyLogin"] }
          }
        }
      ]
    }
  ]
}
